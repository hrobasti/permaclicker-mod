{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "PermaClicker",
  "description": "Keeps your attack going while you're AFK: continuous mining for block farms, or full-strength hits for mob and animal farms. For single-player or servers that allow it.",
  "authors": [
    {
      "name": "kroet.net",
      "contact": {
        "homepage": "https://kroet.net"
      }
    }
  ],
  "license": "MIT",
  "icon": "assets/permaclicker/icon.png",
  "contact": {
    "homepage": "https://kroet.net",
    "sources": "https://github.com/hrobasti/permaclicker-mod",
    "issues": "https://github.com/hrobasti/permaclicker-mod/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["net.kroet.permaclicker.fabric.PermaClickFabricEntrypoint"],
    "modmenu": ["net.kroet.permaclicker.fabric.PermaClickerModMenuApi"]
  },
  "mixins": ["permaclicker.client.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "turtlelib": ">=${turtlelib_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_language_version}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_sponsors": "https://github.com/sponsors/hrobasti",
        "modmenu.kofi": "https://ko-fi.com/kroet"
      }
    }
  }
}
